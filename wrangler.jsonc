{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "login",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Required by @cloudflare/workers-oauth-provider before it enables Client ID Metadata
  // Documents: outbound fetches never use same-zone routing (SSRF protection).
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],

  // The Worker is reachable only on its custom domain (attached by Terraform in phase 3),
  // never on *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Stylesheet, font, lattice pattern and icon. Served before the Worker runs; their headers
  // are in public/_headers.
  "assets": {
    "directory": "./public",
  },

  // Phase 4 will decide what is logged. Invocation logs would record full request URLs,
  // which carry authorization codes and state on /authorize and /callback/*.
  "observability": {
    "enabled": false,
  },

  "vars": {
    "ISSUER": "https://login.2earl.com",
    // Google OAuth client ID. Public by design: it appears in every sign-in URL.
    "GOOGLE_CLIENT_ID": "862466313467-kgrf9bd3j96b0peeujk8h5j3ak49ugou.apps.googleusercontent.com",
    // Sign-up (DESIGN D9, §4.9): "false" lets anyone create an account; "true" admits only
    // invited ones. The owner can switch it on /admin/invitations without a deploy; that setting
    // wins over this default.
    "LOGIN_LOCKED": "false",
    // The MCP gateway's canonical resource URL: the only audience tokens are issued for.
    "MCP_RESOURCE": "https://mcp.2earl.com/mcp",
    // Prompt share's website (phase P2): the audience of its sign-in tokens.
    "PROMPTSHARE_RESOURCE": "https://promptshare.cc",
    // Second factor (DESIGN §4.7). "true" makes every user enrol before using the account.
    // Users who enrolled are challenged either way, and /admin always requires it.
    "MFA_REQUIRED": "false",
    // The next ID-token signing key's public JWK, published in /.well-known/jwks.json ahead of a
    // rotation so relying parties already have it (DESIGN §4.11). Empty: no rotation pending.
    "OIDC_NEXT_PUBLIC_KEY": "",
  },

  // Set by the deploy workflow from the GitHub `production` environment. Deploys fail if any
  // is missing.
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_SECRET",
      "SESSION_PEPPER",
      "CONSENT_REMEMBER_SECRET",
      // Encrypts authenticator-app secrets and keys recovery-code hashes (DESIGN §4.7).
      "MFA_ENCRYPTION_KEY",
      // Google account ID of the only user who may open /admin (DESIGN §4.6).
      "OWNER_GOOGLE_SUB",
      // Private ES256 JSON Web Key that signs OpenID Connect ID tokens (DESIGN §4.11).
      // Make one with `pnpm oidc:key`. Rotate by announcing the next key first
      // (OIDC_NEXT_PUBLIC_KEY), then swapping.
      "OIDC_SIGNING_KEY",
    ],
  },

  // Each 2earl service's AccountEvents entrypoint (src/services.ts): account deletion and export.
  // A binding can only be added once its Worker exists.
  "services": [
    { "binding": "MCP_GATEWAY_EVENTS", "service": "mcp", "entrypoint": "AccountEvents" },
    { "binding": "PROMPTSHARE_EVENTS", "service": "promptshare", "entrypoint": "AccountEvents" },
  ],

  // Sign-in codes and security notices (src/mail.ts), from noreply@2earl.com only. Sending to
  // any address needs Workers Paid and 2earl.com onboarded to Cloudflare Email Service.
  "send_email": [{ "name": "MAILER", "allowed_sender_addresses": ["noreply@2earl.com"] }],

  // Per-IP limit on the sign-in endpoints, on top of the zone rate-limit rule (infra/firewall.tf).
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    // POST /oauth/token, per address (shortened). High, because AI assistants' servers share a
    // few addresses for all their users (src/app.ts).
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 1000, "period": 60 },
    },
  ],

  // Created by Terraform (infra/storage.tf), both in the EU jurisdiction. IDs are not secrets.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "login",
      "database_id": "86e9ee5a-6410-45fc-87a3-d3ae0bdd4190",
      "migrations_dir": "migrations",
    },
  ],
  // Owned by @cloudflare/workers-oauth-provider, which requires the binding name OAUTH_KV.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "b6dea62be04345379994f7e08a569984",
    },
  ],

  // Every 15 minutes: account-deletion notices to the services (src/deletion-notices.ts).
  // Daily at 03:17 UTC: expired OAuth records, sessions, sign-in transactions, old audit events
  // (DAILY_CRON in src/index.ts).
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"],
  },
}
