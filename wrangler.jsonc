{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "login",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Required by @cloudflare/workers-oauth-provider before it enables Client ID Metadata
  // Documents: outbound fetches never use same-zone routing (SSRF protection).
  "compatibility_flags": ["global_fetch_strictly_public"],

  // The Worker is reachable only on its custom domain (attached by Terraform in phase 3),
  // never on *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Phase 4 will decide what is logged. Invocation logs would record full request URLs,
  // which carry authorization codes and state on /authorize and /callback/*.
  "observability": {
    "enabled": false,
  },

  "vars": {
    "ISSUER": "https://login.2earl.com",
  },

  // Created by Terraform (infra/storage.tf), both in the EU jurisdiction. IDs are not secrets.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "login",
      "database_id": "86e9ee5a-6410-45fc-87a3-d3ae0bdd4190",
      "migrations_dir": "migrations",
    },
  ],
  // Owned by @cloudflare/workers-oauth-provider, which requires the binding name OAUTH_KV.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "b6dea62be04345379994f7e08a569984",
    },
  ],
}
