{
  "name": "@2earl/login",
  "version": "0.0.0",
  "private": true,
  "description": "Identity service and OAuth 2.1 authorization server for 2earl.com",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "typecheck": "node scripts/asset-versions.mjs --check && wrangler types --check && tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p e2e/worker",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:version": "node scripts/asset-versions.mjs",
    "oidc:key": "node scripts/oidc-key.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@node-saml/node-saml": "5.2.0",
    "@simplewebauthn/server": "14.1.0",
    "hono": "4.13.17",
    "jose": "6.2.15",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "xml-crypto": "6.4.0"
  }
}
